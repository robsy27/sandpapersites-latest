# Apache/LiteSpeed config for the static export (Hostinger, cPanel).
# Copied into the site root by the build.

# Serve the exported 404 page for unknown URLs
ErrorDocument 404 /404.html

# Next.js fingerprints these filenames, so they can be cached indefinitely.
# HTML is deliberately excluded so new deploys are picked up immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
