# Copy to .env.local for local development, and set the same variables in
# Hostinger (hPanel -> your site -> Environment variables) for production.
# .env* is gitignored, so nothing here ends up in the repo.

# --- Contact form delivery --------------------------------------------------
# Get a key at https://resend.com (free tier is ample for a contact form).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries land. Kept out of the repo so a personal address is never
# published in public source.
CONTACT_TO_EMAIL=you@example.com

# Optional. Until you verify a domain in Resend, leave this unset — Resend's
# shared sender delivers to your own account address, which is enough to get
# going. Once sandpapersites.co.uk is verified, set:
#   CONTACT_FROM_EMAIL="Sandpaper Sites <contact@sandpapersites.co.uk>"
# CONTACT_FROM_EMAIL=
